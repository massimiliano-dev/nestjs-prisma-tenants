{
  "name": "@massimiliano-dev/nestjs-prisma-tenants",
  "version": "0.2.0",
  "description": "NestJS module for database-per-tenant apps with Prisma and PostgreSQL. No request-scoped providers.",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/nestjs-prisma-tenants.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/massimiliano-dev/nestjs-prisma-tenants#readme",
  "bugs": "https://github.com/massimiliano-dev/nestjs-prisma-tenants/issues",
  "keywords": [
    "nestjs",
    "prisma",
    "multi-tenant",
    "multitenancy",
    "database-per-tenant",
    "postgresql",
    "saas"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@massimiliano-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@massimiliano-dev/nestjs-prisma-tenants-core": "workspace:^"
  },
  "devDependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/testing": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "@types/supertest": "^7.2.1",
    "pg": "^8.23.1",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.1.0"
  }
}
