{
  "name": "@massimiliano-dev/nestjs-prisma-tenants-cli",
  "version": "0.1.0",
  "description": "CLI to list, create, archive and migrate tenant databases (tenants migrate --all --concurrency 5 --dry-run).",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/nestjs-prisma-tenants.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/massimiliano-dev/nestjs-prisma-tenants#readme",
  "bugs": "https://github.com/massimiliano-dev/nestjs-prisma-tenants/issues",
  "keywords": [
    "nestjs",
    "prisma",
    "multi-tenant",
    "multitenancy",
    "database-per-tenant",
    "postgresql",
    "saas"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@massimiliano-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@massimiliano-dev/nestjs-prisma-tenants-core": "workspace:^",
    "commander": "^15.0.0",
    "execa": "^10.2.1"
  },
  "bin": {
    "tenants": "./dist/bin.js"
  },
  "devDependencies": {
    "@massimiliano-dev/nestjs-prisma-tenants-prisma": "workspace:^",
    "pg": "^8.23.1",
    "@types/pg": "^8.23.1"
  }
}
