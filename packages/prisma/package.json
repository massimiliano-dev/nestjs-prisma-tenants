{
  "name": "@massimiliano-dev/nestjs-prisma-tenants-prisma",
  "version": "0.2.0",
  "description": "Prisma 7 adapter and migrator for nestjs-prisma-tenants.",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/nestjs-prisma-tenants.git",
    "directory": "packages/prisma"
  },
  "homepage": "https://github.com/massimiliano-dev/nestjs-prisma-tenants#readme",
  "bugs": "https://github.com/massimiliano-dev/nestjs-prisma-tenants/issues",
  "keywords": [
    "nestjs",
    "prisma",
    "multi-tenant",
    "multitenancy",
    "database-per-tenant",
    "postgresql",
    "saas"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@massimiliano-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "generate:fixture": "PRISMA_HIDE_UPDATE_MESSAGE=1 DATABASE_URL=postgresql://localhost:5432/unused prisma generate --config test/fixture/prisma.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@massimiliano-dev/nestjs-prisma-tenants-core": "workspace:^",
    "execa": "^10.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "prisma": "~7.10.1",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.0"
  }
}
